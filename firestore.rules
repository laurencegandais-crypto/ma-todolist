rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberOf(householdId) {
      return signedIn() && request.auth.token.email in get(/databases/$(database)/documents/households/$(householdId)).data.memberEmails;
    }
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
      match /tasks/{taskId} { allow read, write: if signedIn() && request.auth.uid == userId; }
    }
    match /households/{householdId} {
      allow read: if signedIn() && request.auth.token.email in resource.data.memberEmails;
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerUid && request.auth.token.email in request.resource.data.memberEmails;
      allow update, delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
      match /tasks/{taskId} { allow read, write: if memberOf(householdId); }
    }
  }
}
